                None,
            ),
            (
                f"fete-defunts-{y}@fr.dcal",
                dt.date(y, 11, 2),
                "Commémoration des fidèles défunts (Fête des Morts)",
                "Jour du souvenir des défunts, lendemain de la Toussaint (2 novembre).",
                None,
            ),
            (
                f"fete-beaujolais-{y}@fr.dcal",
                beaujolais,
                "Arrivée du Beaujolais Nouveau",
                "Tradition du troisième jeudi de novembre.",
                None,
            ),
            (
                f"fete-sainte-catherine-{y}@fr.dcal",
                dt.date(y, 11, 25),
                "Sainte-Catherine",
                "Fête traditionnelle du 25 novembre (« À la Sainte-Catherine, tout bois prend racine »).",
                None,
            ),
            (
                f"fete-black-friday-{y}@fr.dcal",
                black_friday,
                "Black Friday",
                "Vendredi suivant le quatrième jeudi de novembre.",
                None,
            ),
            (
                f"fete-avent-1-{y}@fr.dcal",
                avent_1,
                "Premier dimanche de l'Avent",
                "Début de la période de l'Avent (quatrième dimanche avant Noël).",
                None,
            ),
            (
                f"fete-saint-nicolas-{y}@fr.dcal",
                dt.date(y, 12, 6),
                "Saint-Nicolas",
                "Fête traditionnelle très célébrée dans l'Est et le Nord de la France (6 décembre).",
                None,
            ),
            (
                f"fete-lumieres-{y}@fr.dcal",
                dt.date(y, 12, 8),
                "Fête des Lumières",
                "Tradition des illuminations du 8 décembre (notamment à Lyon).",
                None,
            ),
            (
                f"fete-reveillon-noel-{y}@fr.dcal",
                dt.date(y, 12, 24),
                "Réveillon de Noël",
                "Veille et soirée du réveillon de Noël (24 décembre).",
                None,
            ),
            (
                f"fete-saint-sylvestre-{y}@fr.dcal",
                dt.date(y, 12, 31),
                "Saint-Sylvestre (Réveillon du Nouvel An)",
                "Dernier jour de l'année et soirée du réveillon du Nouvel An (31 décembre).",
                None,
            ),
        ]
        for uid, d, summary, desc, end_d in items:
            events.append(make_vevent(uid, summary, d, desc, "Fête & Tradition", end_d))
    return events


def build_saisons_heures(years: range) -> list[str]:
    events: list[str] = []
    for y in years:
        # Changements d'heure en Europe : dernier dimanche de mars et dernier dimanche d'octobre
        heure_ete = nth_weekday_of_month(y, 3, 6, -1)
        heure_hiver = nth_weekday_of_month(y, 10, 6, -1)

        events.append(
            make_vevent(
                f"heure-ete-{y}@fr.dcal",
                "Passage à l'heure d'été (+1h)",
                heure_ete,
                "Changement d'heure : à 02h00 il sera 03h00 (UTC+2, heure d'été d'Europe centrale). On avance les horloges d'une heure.",
                "Changement d'heure",
            )
        )
        events.append(
            make_vevent(
                f"heure-hiver-{y}@fr.dcal",
                "Passage à l'heure d'hiver (-1h)",
                heure_hiver,
                "Changement d'heure : à 03h00 il sera 02h00 (UTC+1, heure normale d'Europe centrale). On recule les horloges d'une heure.",
                "Changement d'heure",
            )
        )

        # Saisons astronomiques (Meeus)
        saisons_meta = [
            (
                0,
                "printemps",
                "Équinoxe de printemps (Début du Printemps)",
                "Début astronomique du printemps dans l'hémisphère nord",
            ),
            (
                1,
                "ete",
                "Solstice d'été (Début de l'Été)",
                "Début astronomique de l'été — jour le plus long de l'année dans l'hémisphère nord",
            ),
            (
                2,
                "automne",
                "Équinoxe d'automne (Début de l'Automne)",
                "Début astronomique de l'automne dans l'hémisphère nord",
            ),
            (
                3,
                "hiver",
                "Solstice d'hiver (Début de l'Hiver)",
                "Début astronomique de l'hiver — jour le plus court de l'année dans l'hémisphère nord",
            ),
        ]
        for s_idx, slug, title, desc_prefix in saisons_meta:
            dt_paris = season_datetime_paris(y, s_idx)
            heure_str = dt_paris.strftime("%Hh%M")
            date_str = dt_paris.strftime("%d/%m/%Y")
            tz_name = dt_paris.tzname() or "Europe/Paris"
            desc = f"{desc_prefix} ({date_str} à {heure_str} {tz_name}, heure de Paris)."
            events.append(
                make_vevent(
                    f"saison-{slug}-{y}@fr.dcal",
                    f"{title} ({heure_str})",
                    dt_paris.date(),
                    desc,
                    "Saison",
                )
            )
    return events


def write_atomic(path: Path, content: str) -> None:
    tmp = path.with_suffix(".ics.tmp")
    tmp.write_text(content, encoding="utf-8")
    tmp.replace(path)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Génère et synchronise les calendriers français annuels pour dcal."
    )
    default_dir = (
        Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share"))
        / "dankcal"
        / "calendars"
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=default_dir,
        help=f"Dossier de destination des fichiers .ics (défaut: {default_dir})",
    )
    parser.add_argument(
        "--years-past",
        type=int,
        default=5,
        help="Nombre d'années passées à inclure (défaut: 5)",
    )
    parser.add_argument(
        "--years-ahead",
        type=int,
        default=25,
        help="Nombre d'années futures à générer (défaut: 25)",
    )
    parser.add_argument(
        "--no-sync",
        action="store_true",
        help="Ne pas exécuter 'dcal sync' après la génération",
    )
    args = parser.parse_args()

    now_year = dt.datetime.now(PARIS_TZ).year
    years = range(now_year - args.years_past, now_year + args.years_ahead + 1)

    out_dir: Path = args.output_dir.expanduser().resolve()
    out_dir.mkdir(parents=True, exist_ok=True)

    calendars = [
        (
            "Jours fériés.ics",
            "Jours fériés",
            "#EF4444",
            "Jours fériés officiels en France (Métropole et Alsace-Moselle)",
            build_jours_feries(years),
        ),
        (
            "Fêtes & Traditions.ics",
            "Fêtes & Traditions",
            "#F59E0B",
            "Fêtes civiles, traditionnelles, familiales et journées symboliques de l'année",
            build_fetes_traditions(years),
        ),
        (
            "Saisons & Heures.ics",
            "Saisons & Heures",
            "#10B981",
            "Changements d'heure (été/hiver) et débuts astronomiques des saisons à Paris",
            build_saisons_heures(years),
        ),
    ]

    for filename, cal_name, color, desc, vevents in calendars:
        ics_text = wrap_vcalendar(cal_name, color, desc, vevents)
        write_atomic(out_dir / filename, ics_text)
        print(
            f"[OK] {cal_name} ({len(vevents)} événements sur {years.start}–{years.stop - 1}) -> {out_dir / filename}"
        )

    if not args.no_sync:
        try:
            res = subprocess.run(
                ["dcal", "account", "list", "--json"],
                capture_output=True,
                text=True,
                check=False,
            )
            if "local:calendars" not in (res.stdout or ""):
                subprocess.run(
                    [
                        "dcal",
                        "account",
                        "add",
                        "local",
                        str(out_dir),
                        "--name",
                        "Calendrier Français",
                    ],
                    check=True,
                )
            else:
                subprocess.run(["dcal", "sync", "local:calendars"], check=True)
        except Exception as exc:
            print(f"[WARN] Impossible d'exécuter 'dcal sync': {exc}", file=sys.stderr)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
