            (
                f"ferie-victoire-1945-{y}@fr.dcal",
                dt.date(y, 5, 8),
                "Victoire 1945",
                "Jour férié national — Commémoration de la victoire des Alliés et de la fin de la Seconde Guerre mondiale en Europe (8 mai 1945).",
            ),
            (
                f"ferie-ascension-{y}@fr.dcal",
                paques + dt.timedelta(days=39),
                "Jeudi de l'Ascension",
                "Jour férié national — Quarante jours après Pâques.",
            ),
            (
                f"ferie-lundi-pentecote-{y}@fr.dcal",
                paques + dt.timedelta(days=50),
                "Lundi de Pentecôte",
                "Jour férié national — Cinquante jours après Pâques.",
            ),
            (
                f"ferie-fete-nationale-{y}@fr.dcal",
                dt.date(y, 7, 14),
                "Fête nationale (14 Juillet)",
                "Jour férié national — Commémoration de la Prise de la Bastille (1789) et de la Fête de la Fédération (1790).",
