                f"ferie-noel-{y}@fr.dcal",
                dt.date(y, 12, 25),
                "Jour de Noël",
                "Jour férié national — Fête de la Nativité (25 décembre).",
            ),
            (
                f"ferie-saint-etienne-{y}@fr.dcal",
                dt.date(y, 12, 26),
                "Saint-Étienne (Alsace-Moselle)",
                "Jour férié légal en Alsace-Moselle (lendemain de Noël, 26 décembre).",
