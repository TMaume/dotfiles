#!/usr/bin/env python3
"""
Générateur automatique des calendriers d'événements annuels français pour Dux Calendar (dcal) :
  1. Jours fériés.ics          (#EF4444 - Rouge)
  2. Fêtes & Traditions.ics    (#F59E0B - Ambre)
  3. Saisons & Heures.ics      (#10B981 - Émeraude)

Calcule dynamiquement pour une fenêtre glissante d'années (par défaut : année - 5 à année + 25) :
- Les 11 jours fériés nationaux français (+ Vendredi Saint & Saint-Étienne pour l'Alsace-Moselle)
- Les fêtes civiles, traditionnelles, familiales et symboliques (Réveillon de Noël, Saint-Sylvestre,
  Épiphanie, Chandeleur, Saint-Valentin, Mardi Gras, Cendres, Fête des Grands-Mères, Saint-Patrick,
  Poisson d'avril, Rameaux, Pâques, Fête des Mères avec la règle officielle de décalage de Pentecôte,
  Pentecôte, Fête des Pères, Fête de la Musique, Journées du Patrimoine, Fête des Grands-Pères,
  Octobre Rose, Halloween, Fête des Morts, Beaujolais Nouveau, Sainte-Catherine, Black Friday,
  1er dimanche de l'Avent, Saint-Nicolas, Fête des Lumières, Nouvel An Lunaire...)
- Les changements d'heure (Passage à l'heure d'été / Passage à l'heure d'hiver)
- Les changements de saison astronomiques (Équinoxe de printemps, Solstice d'été, Équinoxe d'automne,
  Solstice d'hiver) calculés à la minute près en heure de Paris selon les algorithmes de Jean Meeus.
"""

from __future__ import annotations

import argparse
import datetime as dt
import math
import os
import subprocess
import sys
from pathlib import Path
from zoneinfo import ZoneInfo

PARIS_TZ = ZoneInfo("Europe/Paris")
SHANGHAI_TZ = ZoneInfo("Asia/Shanghai")

# Termes périodiques de Jean Meeus (Astronomical Algorithms, Chap. 27, Table 27.C)
MEEUS_S24 = [
    (485, 324.96, 1934.136),
    (203, 337.23, 32964.467),
    (199, 342.08, 20.186),
    (182, 27.85, 445267.112),
    (156, 73.14, 45036.886),
    (136, 171.52, 22518.443),
    (77, 222.54, 65928.934),
    (74, 296.72, 3034.906),
    (70, 243.58, 9037.513),
    (58, 119.81, 33718.147),
    (52, 297.17, 150.678),
    (50, 21.02, 2281.226),
    (45, 247.54, 29929.562),
    (44, 325.15, 31555.956),
    (29, 60.93, 4443.417),
    (18, 155.12, 67555.328),
    (17, 288.79, 4562.452),
    (16, 198.04, 62894.029),
    (14, 199.76, 31436.921),
    (12, 95.39, 14577.848),
    (12, 287.11, 31931.756),
    (12, 320.81, 34777.259),
    (9, 227.73, 1222.114),
    (8, 15.45, 16859.074),
]

CHINESE_ZODIAC = [
    "Rat",
    "Buffle",
    "Tigre",
    "Lapin",
    "Dragon",
    "Serpent",
    "Cheval",
    "Chèvre",
    "Singe",
    "Coq",
    "Chien",
    "Cochon",
]


def easter_date(year: int) -> dt.date:
    """Calcule la date du dimanche de Pâques (algorithme de Meeus/Jones/Butcher)."""
    a = year % 19
    b = year // 100
    c = year % 100
    d = b // 4
    e = b % 4
    f = (b + 8) // 25
    g = (b - f + 1) // 3
    h = (19 * a + b - d - g + 15) % 30
    i = c // 4
    k = c % 4
    l = (32 + 2 * e + 2 * i - h - k) % 7
    m = (a + 11 * h + 22 * l) // 451
    month = (h + l - 7 * m + 114) // 31
    day = ((h + l - 7 * m + 114) % 31) + 1
    return dt.date(year, month, day)


def nth_weekday_of_month(year: int, month: int, weekday: int, n: int) -> dt.date:
    """
    Renvoie le n-ième jour de la semaine (weekday: 0=lundi .. 6=dimanche) du mois.
    Si n < 0, compte depuis la fin du mois (-1 = dernier).
    """
    if n > 0:
        first = dt.date(year, month, 1)
        offset = (weekday - first.weekday()) % 7
        return first + dt.timedelta(days=offset + 7 * (n - 1))
    else:
        if month == 12:
            last = dt.date(year + 1, 1, 1) - dt.timedelta(days=1)
        else:
            last = dt.date(year, month + 1, 1) - dt.timedelta(days=1)
        offset = (last.weekday() - weekday) % 7
        return last - dt.timedelta(days=offset + 7 * (-n - 1))


def season_datetime_paris(year: int, season: int) -> dt.datetime:
    """
    Calcule l'instant astronomique exact d'un changement de saison (Meeus Chap. 27)
    converti dans le fuseau Europe/Paris :
      0 = Équinoxe de printemps
      1 = Solstice d'été
      2 = Équinoxe d'automne
      3 = Solstice d'hiver
    """
    y = (year - 2000) / 1000.0
    if season == 0:
        jde0 = (
            2451623.80984
            + 365242.37404 * y
            + 0.05169 * y**2
            - 0.00411 * y**3
            - 0.00057 * y**4
        )
    elif season == 1:
        jde0 = (
            2451716.56767
            + 365241.62603 * y
            + 0.00325 * y**2
            + 0.00888 * y**3
            - 0.00030 * y**4
        )
    elif season == 2:
        jde0 = (
            2451810.21715
            + 365242.01767 * y
            - 0.11575 * y**2
            + 0.00337 * y**3
            + 0.00078 * y**4
        )
    else:
        jde0 = (
            2451900.05952
            + 365242.74049 * y
            - 0.06223 * y**2
            - 0.00823 * y**3
            + 0.00032 * y**4
        )

    t = (jde0 - 2451545.0) / 36525.0
    w = 35999.373 * t - 2.47
    d_lambda = 1 + 0.0334 * math.cos(math.radians(w)) + 0.0007 * math.cos(math.radians(2 * w))
    s = sum(a * math.cos(math.radians(b + c * t)) for a, b, c in MEEUS_S24)
    jde = jde0 + (0.00001 * s) / d_lambda
    # Approximation Delta T (TT - UTC) ~ 69.2 secondes
    jd_utc = jde - (69.2 / 86400.0)
    unix_ts = (jd_utc - 2440587.5) * 86400.0
    return dt.datetime.fromtimestamp(unix_ts, tz=dt.timezone.utc).astimezone(PARIS_TZ)


def new_moon_jde(k: int) -> float:
    """Calcule le Jour Julien Éphéméride d'une nouvelle lune (Meeus Chap. 49)."""
    t = k / 1236.85
    jde = (
        2451550.09766
        + 29.530588861 * k
        + 0.00015437 * t**2
        - 0.000000150 * t**3
        + 0.00000000073 * t**4
    )
    e = 1 - 0.002516 * t - 0.0000074 * t**2
    m = math.radians((2.5534 + 29.10535670 * k - 0.0000014 * t**2 - 0.00000011 * t**3) % 360)
    mp = math.radians(
        (201.5643 + 385.81693528 * k + 0.0107582 * t**2 + 0.00001238 * t**3 - 0.000000058 * t**4)
        % 360
    )
    f = math.radians(
        (160.7108 + 390.67050284 * k - 0.0016118 * t**2 - 0.00000227 * t**3 + 0.000000011 * t**4)
        % 360
    )
    om = math.radians((124.7746 - 1.56375588 * k + 0.0020672 * t**2 + 0.00000215 * t**3) % 360)
    corr = (
        -0.40720 * math.sin(mp)
        + 0.17241 * e * math.sin(m)
        + 0.01608 * math.sin(2 * mp)
        + 0.01039 * math.sin(2 * f)
        + 0.00739 * e * math.sin(mp - m)
        - 0.00514 * e * math.sin(mp + m)
        + 0.00208 * e * e * math.sin(2 * m)
        - 0.00111 * math.sin(mp - 2 * f)
        - 0.00057 * math.sin(mp + 2 * f)
        + 0.00056 * e * math.sin(2 * mp + m)
        - 0.00042 * math.sin(3 * mp)
        + 0.00042 * e * math.sin(m + 2 * f)
        + 0.00038 * math.sin(m - 2 * f)
        - 0.00024 * math.sin(2 * mp - m)
        - 0.00017 * math.sin(om)
    )
    return jde + corr


def lunar_new_year(year: int) -> dt.date:
    """Calcule la date du Nouvel An Lunaire (Nouvel An Chinois) pour l'année donnée."""
    k0 = round((year - 2000 + 0.08) * 12.3685)
    for k in range(k0 - 2, k0 + 3):
        jd_utc = new_moon_jde(k) - (69.2 / 86400.0)
        dt_cn = (
            dt.datetime.fromtimestamp((jd_utc - 2440587.5) * 86400.0, tz=dt.timezone.utc)
            .astimezone(SHANGHAI_TZ)
            .date()
        )
        if dt.date(year, 1, 21) <= dt_cn <= dt.date(year, 2, 20):
            return dt_cn
    return dt.date(year, 2, 1)


def ics_escape(text: str) -> str:
    return (
        text.replace("\\", "\\\\")
        .replace(";", "\\;")
        .replace(",", "\\,")
        .replace("\n", "\\n")
    )


def make_vevent(
    uid: str,
    summary: str,
    start_date: dt.date,
    description: str = "",
    categories: str = "",
    end_date: dt.date | None = None,
) -> str:
    if end_date is None:
        end_date = start_date + dt.timedelta(days=1)
    lines = [
        "BEGIN:VEVENT",
        f"UID:{uid}",
        "DTSTAMP:20260101T000000Z",
        f"DTSTART;VALUE=DATE:{start_date.strftime('%Y%m%d')}",
        f"DTEND;VALUE=DATE:{end_date.strftime('%Y%m%d')}",
        f"SUMMARY:{ics_escape(summary)}",
        "STATUS:CONFIRMED",
        "TRANSP:TRANSPARENT",
    ]
    if description:
        lines.append(f"DESCRIPTION:{ics_escape(description)}")
    if categories:
        lines.append(f"CATEGORIES:{ics_escape(categories)}")
    lines.append("END:VEVENT")
    return "\r\n".join(lines)


def wrap_vcalendar(cal_name: str, color: str, description: str, events: list[str]) -> str:
    header = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//Dux Calendar//Calendrier Francais Annuel//FR",
        "CALSCALE:GREGORIAN",
        "METHOD:PUBLISH",
        f"X-WR-CALNAME:{ics_escape(cal_name)}",
        f"X-WR-CALDESC:{ics_escape(description)}",
        "X-WR-TIMEZONE:Europe/Paris",
        f"X-APPLE-CALENDAR-COLOR:{color}",
        f"COLOR:{color}",
    ]
    footer = ["END:VCALENDAR", ""]
    return "\r\n".join(header + events + footer)


def build_jours_feries(years: range) -> list[str]:
    events: list[str] = []
    for y in years:
        paques = easter_date(y)
        items = [
            (
                f"ferie-jour-de-lan-{y}@fr.dcal",
                dt.date(y, 1, 1),
                "Jour de l'An",
                "Jour férié national — Premier jour de l'année civile.",
