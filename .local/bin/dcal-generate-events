            (
                f"ferie-toussaint-{y}@fr.dcal",
                dt.date(y, 11, 1),
                "La Toussaint",
                "Jour férié national — Fête de tous les saints (1er novembre).",
            ),
            (
                f"ferie-armistice-1918-{y}@fr.dcal",
                dt.date(y, 11, 11),
                "Armistice 1918",
                "Jour férié national — Commémoration de l'Armistice du 11 novembre 1918 et hommage à tous les morts pour la France.",
