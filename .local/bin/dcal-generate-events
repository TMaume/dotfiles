def build_fetes_traditions(years: range) -> list[str]:
    events: list[str] = []
    for y in years:
        paques = easter_date(y)
        pentecote = paques + dt.timedelta(days=49)

        # Épiphanie : 1er dimanche après le 1er janvier (donc entre le 2 et le 8 janvier)
        jan2 = dt.date(y, 1, 2)
        epiphanie_dim = jan2 + dt.timedelta(days=(6 - jan2.weekday()) % 7)

        # Fête des Mères en France : dernier dimanche de mai, sauf s'il coïncide avec la Pentecôte
        # auquel cas elle est repoussée au premier dimanche de juin.
        dernier_dim_mai = nth_weekday_of_month(y, 5, 6, -1)
        if dernier_dim_mai == pentecote:
            fete_meres = nth_weekday_of_month(y, 6, 6, 1)
        else:
            fete_meres = dernier_dim_mai

        # Fête des Pères : 3e dimanche de juin
        fete_peres = nth_weekday_of_month(y, 6, 6, 3)

        # Fête des Grands-Mères : 1er dimanche de mars
        fete_grands_meres = nth_weekday_of_month(y, 3, 6, 1)

        # Fête des Grands-Pères : 1er dimanche d'octobre
        fete_grands_peres = nth_weekday_of_month(y, 10, 6, 1)

        # Fête des Voisins : dernier vendredi de mai
        fete_voisins = nth_weekday_of_month(y, 5, 4, -1)

        # Journées européennes du patrimoine : 3e week-end de septembre (samedi & dimanche)
        patrimoine_sam = nth_weekday_of_month(y, 9, 5, 3)
        patrimoine_fin = patrimoine_sam + dt.timedelta(days=2)

        # Beaujolais Nouveau : 3e jeudi de novembre
        beaujolais = nth_weekday_of_month(y, 11, 3, 3)

        # Black Friday : vendredi suivant le 4e jeudi de novembre
        thanksgiving = nth_weekday_of_month(y, 11, 3, 4)
        black_friday = thanksgiving + dt.timedelta(days=1)

        # 1er dimanche de l'Avent : 4e dimanche avant Noël (dimanche entre le 27 nov. et le 3 déc.)
        noel = dt.date(y, 12, 25)
        # Nombre de jours à reculer depuis Noël pour atteindre le dimanche précédent (1..7)
        days_before_noel_to_sun = (noel.weekday() + 1) % 7 or 7
        avent_1 = noel - dt.timedelta(days=days_before_noel_to_sun + 21)

        # Nouvel An Lunaire
        lny_date = lunar_new_year(y)
        zodiac = CHINESE_ZODIAC[(y - 2020) % 12]

        items: list[tuple[str, dt.date, str, str, dt.date | None]] = [
            (
                f"fete-epiphanie-{y}@fr.dcal",
                epiphanie_dim,
                "Épiphanie (Galette des Rois)",
                "Célébrée en France le premier dimanche après le 1er janvier (et traditionnellement le 6 janvier).",
                None,
            ),
            (
                f"fete-nouvel-an-lunaire-{y}@fr.dcal",
                lny_date,
                f"Nouvel An Lunaire (Année du {zodiac})",
                f"Nouvel An chinois / lunaire — début de l'année du {zodiac}.",
                None,
            ),
            (
                f"fete-chandeleur-{y}@fr.dcal",
                dt.date(y, 2, 2),
                "La Chandeleur",
                "Fête des chandelles et tradition des crêpes (40 jours après Noël).",
                None,
            ),
            (
                f"fete-saint-valentin-{y}@fr.dcal",
                dt.date(y, 2, 14),
                "Saint-Valentin",
                "Fête des amoureux (14 février).",
                None,
            ),
            (
                f"fete-mardi-gras-{y}@fr.dcal",
                paques - dt.timedelta(days=47),
                "Mardi Gras",
                "Dernier jour du Carnaval, veille du mercredi des Cendres (47 jours avant Pâques).",
                None,
            ),
            (
                f"fete-mercredi-cendres-{y}@fr.dcal",
                paques - dt.timedelta(days=46),
                "Mercredi des Cendres",
                "Premier jour du Carême (46 jours avant Pâques).",
                None,
            ),
            (
                f"fete-grands-meres-{y}@fr.dcal",
                fete_grands_meres,
                "Fête des Grands-Mères",
                "Célébrée chaque année en France le premier dimanche de mars.",
                None,
            ),
            (
                f"fete-droits-des-femmes-{y}@fr.dcal",
                dt.date(y, 3, 8),
                "Journée internationale des droits des femmes",
                "Journée internationale célébrée le 8 mars.",
                None,
            ),
            (
                f"fete-saint-patrick-{y}@fr.dcal",
                dt.date(y, 3, 17),
                "Saint-Patrick",
                "Fête nationale irlandaise et fête culturelle célébrée le 17 mars.",
                None,
            ),
            (
                f"fete-francophonie-{y}@fr.dcal",
